# Copier en .env et adapter. Consommé par docker-compose.yml et (plus tard) par api/ / worker/.

# --- PostgreSQL (service `db`) ---
# DATABASE_URL est ce que lit solver_store/registry.py (§7.2) — hôte `db` car consommé depuis
# le réseau docker-compose (conteneurs `dev`/`api`) ; en dehors de compose, remplacer `db` par
# `localhost` (le port est publié sur l'hôte).
POSTGRES_USER=prisme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=prisme
POSTGRES_PORT=5432
DATABASE_URL=postgresql://prisme:changeme@db:5432/prisme

# --- Base de référence GreenSIG (service `db_greensig`, profil `greensig`) ---
# Isolée de DATABASE_URL ci-dessus : dump réel du client (adapters/greensig/), jamais mélangée
# à la base applicative de PRISME. Port différent (5433) pour tourner en parallèle de `db`.
# GREENSIG_DATABASE_URL est ce que lit adapters/greensig/extraction.py — hôte `db_greensig` (port
# interne 5432) car consommé depuis le réseau docker-compose ; en dehors de compose, remplacer
# par `localhost:5433` (le port publié sur l'hôte).
GREENSIG_DB_PASSWORD=changeme
GREENSIG_DB_PORT=5433
GREENSIG_DATABASE_URL=postgresql://greensig:changeme@db_greensig:5432/greensig

# Rôle lecture seule dédié (adapters/agent_comprehension/exploration_bdd.py) — créé via
# `scripts/creer_role_lecture_seule_greensig.py`, jamais le rôle admin `greensig` ci-dessus.
GREENSIG_DB_LECTURE_SEULE_PASSWORD=changeme_lecture_seule
GREENSIG_LECTURE_SEULE_DATABASE_URL=postgresql://greensig_lecture_seule:changeme_lecture_seule@db_greensig:5432/greensig

# --- Exploration BDD par client, hors GreenSIG (POST /sources/explorer-bdd) ---
# GreenSIG est résolu via GREENSIG_LECTURE_SEULE_DATABASE_URL ci-dessus ; tout autre client lit
# PRISME_DSN_LECTURE_SEULE_<CLIENT_ID>, <CLIENT_ID> étant le client_id en majuscules, caractères
# non alphanumériques remplacés par "_" (ex. client_id "acme-corp" -> PRISME_DSN_LECTURE_SEULE_ACME_CORP).
# Jamais de valeur par défaut : absent = exploration BDD non configurée pour ce client (404
# explicite), jamais un DSN deviné. Provisionner le rôle correspondant via
# `scripts/creer_role_lecture_seule_greensig.py --role ... --base ... --dsn-admin ...`.
# PRISME_DSN_LECTURE_SEULE_<CLIENT_ID>=postgresql://<role_lecture_seule>:<mdp>@<hote>:<port>/<base>

# --- GreenSIG : mode d'intégration (adapters/greensig/service.py) ---
# db (défaut) = connexion Postgres directe (GREENSIG_DATABASE_URL ci-dessus).
# api = appel HTTP vers l'API publique GreenSIG (adapters/greensig/extraction_api.py) —
# les deux adaptateurs coexistent, ce flag choisit lequel /planifier/greensig et
# /adapters/greensig/ingerer appellent.
GREENSIG_MODE=db

# Requis seulement si GREENSIG_MODE=api. Pas de valeur par défaut (contrairement à db_greensig,
# dont le port docker-compose est fixe) : absence lève une erreur explicite au premier appel
# plutôt qu'un mauvais hôte silencieux.
GREENSIG_API_BASE_URL=
# Clé fournie par GreenSIG, envoyée en Authorization: Bearer <clé> — jamais en clair dans les logs.
GREENSIG_API_KEY=

# --- Génération LLM (generation/agents/client_llm.py) ---
# Fournisseur : Kimi en direct dès que KIMI_API_KEY est renseignée (clé créée depuis la console
# Kimi, platform.kimi.ai), OpenRouter sinon. PRISME_LLM_FOURNISSEUR=kimi|openrouter force le choix.
# PRISME_LLM_MODEL (défaut "moonshotai/kimi-k2.6", soit "kimi-k2.6" en appel direct) et
# PRISME_LLM_MODEL_<AGENT>/PRISME_LLM_TIMEOUT_SECONDES_<AGENT> (surcharges par
# agent, ex. PRISME_LLM_MODEL_DEBUGGER) valent pour les deux fournisseurs.
PRISME_LLM_FOURNISSEUR=
PRISME_LLM_MODEL=
# Nombre maximal d'appels LLM simultanés pour tout le processus — vide ou 0 : aucune limite.
# À régler sur la limite de concurrence de ton compte fournisseur : un compte Kimi d'entrée de
# gamme n'en accepte qu'une (erreur 429 « max organization concurrency: 1 » sinon, puisque
# l'Analyste et le Benchmarker partent en parallèle). Les appels en trop attendent leur tour
# au lieu d'être refusés.
PRISME_LLM_CONCURRENCE_MAX=
# Réflexion du modèle Kimi (activee | desactivee) — vide : active, comportement du modèle.
# Mesuré sur kimi-k2.6 : avec réflexion, 85 à 92 % des tokens de sortie sont de la réflexion et
# un appel de compréhension dure 5 à 16 min ; sans, il tient en moins d'une minute. Surcharge par
# agent avec PRISME_LLM_REFLEXION_<AGENT> (COMPREHENSION, ANALYSTE, BENCHMARKER, ARCHITECTE,
# GENERATEUR, TESTEUR, DEBUGGER, DOCUMENTATION, SUPERVISION). Sans effet via OpenRouter.
# Exemple : couper partout, garder pour les agents qui écrivent le code du solveur.
PRISME_LLM_REFLEXION=
# PRISME_LLM_REFLEXION_GENERATEUR=activee
# PRISME_LLM_REFLEXION_DEBUGGER=activee
KIMI_API_KEY=
# Optionnel — hôte d'API de la plateforme Kimi internationale par défaut si absent. À renseigner
# si ta clé vient de la plateforme chinoise (https://api.moonshot.cn/v1), dont les clés sont
# distinctes et refusées par l'autre :
# KIMI_API_BASE_URL=
OPENROUTER_API_KEY=
# Optionnel — défaut https://openrouter.ai/api/v1 si absent :
# OPENROUTER_API_BASE_URL=
# --- Bac à sable d'exécution (sandbox/runner.py) ---
# Budget de temps d'une exécution de solveur, en secondes — défaut 120 si absent.
# Mesuré : une recherche tabou sur 84 tâches en mode heures demande ~90 s en Python pur sur un
# cœur, et la cascade ne la juge que sur de petites instances : un budget trop court transforme
# un solveur valide en échec d'exécution. Toute valeur changée ici doit l'être aussi dans les
# prompts de génération, qui enseignent ce budget aux agents.
PRISME_SANDBOX_LIMITE_TEMPS_S=

# --- Observabilité LLM (LangSmith) ---
# Tracing natif LangChain/LangGraph (voir generation/agents/client_llm.py,
# generation/graph.py, adapters/agent_comprehension/) — aucune instrumentation
# maison. Aucun changement de code requis : dès que
# LANGCHAIN_TRACING_V2=true et LANGCHAIN_API_KEY sont présents, chaque appel
# LLM de chaque agent est tracé automatiquement. Clé à récupérer sur
# smith.langchain.com (Settings -> API Keys).
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=prisme
# À décommenter seulement si LangSmith self-hosted ou région autre que US par défaut :
# LANGCHAIN_ENDPOINT=

# --- API (service `api`, pas encore câblé dans le Dockerfile applicatif) ---
API_PORT=8000

# --- Authentification JWT (api/routes/auth.py) ---
# Clé secrète pour signer les tokens JWT (générer avec: python -c "import secrets; print(secrets.token_hex(32))")
# IMPORTANT: Changer cette valeur en production !
JWT_SECRET_KEY=changeme_generer_une_cle_aleatoire_forte
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440  # 24 heures

# Échappatoire DEV UNIQUEMENT : désactive toute vérification de token sur
# l'API (aucune route ne demande de JWT, tout se comporte comme un admin).
# JAMAIS true en production. Laisser vide/absent = authentification active.
PRISME_AUTH_DESACTIVEE=

# --- Agent de supervision (supervision/, §2, MT7) ---
# Boucle périodique désactivée par défaut (laisser vide/absent) : elle
# appelle un LLM et écrit en base à chaque passe, ne doit jamais se
# déclencher pendant les tests ni un `uvicorn --reload` occasionnel sans
# opt-in explicite. Le déclenchement manuel (POST /supervision/analyser)
# reste disponible que cette variable soit positionnée ou non.
PRISME_SUPERVISION_ACTIVE=
PRISME_SUPERVISION_INTERVALLE_SECONDES=3600

# Production uniquement (ex. Railway, docs/deploiement_railway.md) : URL exactes du frontend autorisées
# à appeler l'API, séparées par des virgules. localhost reste toujours autorisé pour le dev.
# PRISME_CORS_ORIGINES=https://prisme-front.up.railway.app

# Compte administrateur initial (api/admin_initial.py) : créé au démarrage de l'API s'il n'existe pas
# encore, jamais modifié ensuite (changer le mot de passe depuis l'interface). Mot de passe : 12 caractères min.
# PRISME_ADMIN_EMAIL=admin@exemple.ma
# PRISME_ADMIN_MOT_DE_PASSE=
