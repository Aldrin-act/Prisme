# Copier en .env et adapter. Consommé par docker-compose.yml et (plus tard) par api/ / worker/.

# --- PostgreSQL (service `db`) ---
# Note : ne remplace pas encore solver_store/registry.py, qui reste SQLite (choix documenté
# dans CLAUDE.md) tant que la migration de la Phase 8 n'est pas faite.
POSTGRES_USER=prisme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=prisme
POSTGRES_PORT=5432
# URL de connexion complète, pratique pour un futur ORM/driver (asyncpg, psycopg, SQLAlchemy...)
DATABASE_URL=postgresql://prisme:changeme@db:5432/prisme

# --- Génération LLM (generation/agents/client_llm.py) ---
PRISME_LLM_PROVIDER=anthropic
PRISME_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- API (service `api`, pas encore câblé dans le Dockerfile applicatif) ---
API_PORT=8000
