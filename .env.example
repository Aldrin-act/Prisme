# Copier en .env et adapter. Consommé par docker-compose.yml et (plus tard) par api/ / worker/.

# --- PostgreSQL (service `db`) ---
# DATABASE_URL est ce que lit solver_store/registry.py (§7.2) — hôte `db` car consommé depuis
# le réseau docker-compose (conteneurs `dev`/`api`) ; en dehors de compose, remplacer `db` par
# `localhost` (le port est publié sur l'hôte).
POSTGRES_USER=prisme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=prisme
POSTGRES_PORT=5432
DATABASE_URL=postgresql://prisme:changeme@db:5432/prisme

# --- Base de référence GreenSIG (service `db_greensig`, profil `greensig`) ---
# Isolée de DATABASE_URL ci-dessus : dump réel du client (adapters/greensig/), jamais mélangée
# à la base applicative de PRISME. Port différent (5433) pour tourner en parallèle de `db`.
# GREENSIG_DATABASE_URL est ce que lit adapters/greensig/extraction.py — hôte `db_greensig` (port
# interne 5432) car consommé depuis le réseau docker-compose ; en dehors de compose, remplacer
# par `localhost:5433` (le port publié sur l'hôte).
GREENSIG_DB_PASSWORD=changeme
GREENSIG_DB_PORT=5433
GREENSIG_DATABASE_URL=postgresql://greensig:changeme@db_greensig:5432/greensig

# Rôle lecture seule dédié (adapters/agent_comprehension/exploration_bdd.py) — créé via
# `scripts/creer_role_lecture_seule_greensig.py`, jamais le rôle admin `greensig` ci-dessus.
GREENSIG_DB_LECTURE_SEULE_PASSWORD=changeme_lecture_seule
GREENSIG_LECTURE_SEULE_DATABASE_URL=postgresql://greensig_lecture_seule:changeme_lecture_seule@db_greensig:5432/greensig

# --- Génération LLM (generation/agents/client_llm.py) ---
# PRISME_LLM_PROVIDER : "anthropic" (défaut), "openai" ou "mistral".
PRISME_LLM_PROVIDER=anthropic
PRISME_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
NVIDIA_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=

# --- API (service `api`, pas encore câblé dans le Dockerfile applicatif) ---
API_PORT=8000

# --- Authentification JWT (api/routes/auth.py) ---
# Clé secrète pour signer les tokens JWT (générer avec: python -c "import secrets; print(secrets.token_hex(32))")
# IMPORTANT: Changer cette valeur en production !
JWT_SECRET_KEY=changeme_generer_une_cle_aleatoire_forte
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440  # 24 heures

# Échappatoire DEV UNIQUEMENT : désactive toute vérification de token sur
# l'API (aucune route ne demande de JWT, tout se comporte comme un admin).
# JAMAIS true en production. Laisser vide/absent = authentification active.
PRISME_AUTH_DESACTIVEE=
